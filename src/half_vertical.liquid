<style>
  .countdown-wrap { width: 100%; height: 100%; }
  .countdown-number { font-size: 96px; font-weight: 700; line-height: 1; margin: 0; }
  .countdown-label { font-size: 22px; margin: 6px 0 0; text-align: center; }
</style>

<div class="screen">
  <div class="view view--half_vertical">

    <div class="title_bar">
      <p class="title">{{ countdown_title }}</p>
    </div>

    <div class="layout flex flex--col flex--center-x flex--center-y countdown-wrap">
      {% if countdown_image != blank %}
        <img class="image"
          src="data:image/png;base64,{{ countdown_image }}"
          alt=""
          style="max-height:140px; margin-bottom:16px;" />
      {% endif %}

      <p class="countdown-number">{{ days_until }}</p>
      <p class="countdown-label">day{% if days_until != 1 %}s{% endif %} until {{ countdown_title }}</p>
    </div>

  </div>
</div>
